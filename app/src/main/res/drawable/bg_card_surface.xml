<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Subtle warm surface for cards with soft gradient and rounded corners -->
    <gradient
        android:angle="90"
        android:startColor="@color/white"
        android:endColor="@color/color_cream_100"
        android:centerColor="@color/color_cream_50" />

    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#20FFFFFF" />

</shape>

