<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded floating nav container background: warm off-white with subtle stroke -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/color_cream_50" />
    <corners android:radius="@dimen/lab_corner_xxl" />
    <stroke android:width="1dp" android:color="#1A000000" />
    <!-- subtle inner shadow effect via padding (Android does not support real inner shadow here) -->
    <padding android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="0dp"/>
</shape>


