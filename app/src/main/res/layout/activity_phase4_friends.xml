<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".Phase4FriendsActivity">

    <TextView
        android:id="@+id/tvFriendsHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Friends"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/phase4FriendsInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage friend requests and connections."
        android:layout_marginBottom="12dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFriends"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <TextView
        android:id="@+id/tvFriendsEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No friends to show"
        android:visibility="gone"
        android:gravity="center"
        android:layout_marginTop="8dp"/>

    <ProgressBar
        android:id="@+id/pbFriendsLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        android:layout_gravity="center"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFriendsRefresh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Refresh"/>

</LinearLayout>

