<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_emergency_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_2xl"
        android:paddingBottom="@dimen/fragment_bottom_padding"
        android:clipToPadding="false">

        <!-- ===== HEADER SECTION ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_2xl">

            <TextView
                android:id="@+id/emergencyTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/emergency_mode_title"
                style="@style/TextStyle.Emergency.Display" />

            <!-- ACTIVE Pill -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/corner_full"
                app:cardBackgroundColor="@color/color_red_600"
                app:cardElevation="0dp">
                <TextView
                    android:id="@+id/emergencyActivePill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md"
                    android:paddingTop="@dimen/spacing_xs"
                    android:paddingBottom="@dimen/spacing_xs"
                    android:text="@string/emergency_active"
                    style="@style/TextStyle.Emergency.Label"
                    android:textColor="@color/text_inverse"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ===== DEVICE STATUS ROW ===== -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Dark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_3xl">

            <LinearLayout
                android:id="@+id/deviceStatusRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="@dimen/spacing_md"
                android:weightSum="4">

                <!-- Battery -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:src="@drawable/ic_battery"
                        app:tint="@color/text_inverse"
                        android:contentDescription="@string/emergency_battery_status" />
                    <TextView
                        android:id="@+id/batteryStatusValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="78%"
                        style="@style/TextStyle.Emergency.Body"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/spacing_xs" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/emergency_battery_status"
                        style="@style/TextStyle.Emergency.Label"
                        android:layout_marginTop="@dimen/spacing_xxs" />
                </LinearLayout>

                <!-- Network -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:src="@drawable/ic_weather_sunny"
                        app:tint="@color/text_inverse"
                        android:contentDescription="@string/emergency_network_status" />
                    <TextView
                        android:id="@+id/networkStatusValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4G"
                        style="@style/TextStyle.Emergency.Body"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/spacing_xs" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/emergency_network_status"
                        style="@style/TextStyle.Emergency.Label"
                        android:layout_marginTop="@dimen/spacing_xxs" />
                </LinearLayout>

                <!-- Mesh -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:src="@drawable/ic_alert_circle"
                        app:tint="@color/text_inverse"
                        android:contentDescription="@string/emergency_mesh_status" />
                    <TextView
                        android:id="@+id/meshStatusValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        style="@style/TextStyle.Emergency.Body"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/spacing_xs" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/emergency_mesh_status"
                        style="@style/TextStyle.Emergency.Label"
                        android:layout_marginTop="@dimen/spacing_xxs" />
                </LinearLayout>

                <!-- GPS -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:src="@drawable/ic_location"
                        app:tint="@color/text_inverse"
                        android:contentDescription="@string/emergency_gps_status" />
                    <TextView
                        android:id="@+id/gpsStatusValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Off"
                        style="@style/TextStyle.Emergency.Body"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/spacing_xs" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/emergency_gps_status"
                        style="@style/TextStyle.Emergency.Label"
                        android:layout_marginTop="@dimen/spacing_xxs" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== SOS BUTTON ===== -->
        <FrameLayout
            android:id="@+id/btnSendSosEmergency"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:background="@drawable/emergency_fab_background"
            android:clickable="true"
            android:focusable="true"
            android:elevation="@dimen/elevation_high"
            android:contentDescription="@string/emergency_sos_broadcast">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_gravity="center">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/icon_xl"
                    android:layout_height="@dimen/icon_xl"
                    android:src="@drawable/ic_sos"
                    app:tint="@color/white"
                    android:contentDescription="@string/emergency_sos_broadcast" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/emergency_sos_short"
                    style="@style/TextStyle.Emergency.Display"
                    android:textSize="24sp"
                    android:layout_marginTop="@dimen/spacing_sm" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/emergency_broadcasting"
                    style="@style/TextStyle.Emergency.Label"
                    android:textColor="@color/text_inverse"
                    android:alpha="0.8"
                    android:layout_marginTop="@dimen/spacing_xxs" />
            </LinearLayout>
        </FrameLayout>

        <!-- Location broadcast message -->
        <TextView
            android:id="@+id/emergencyLastAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/emergency_location_broadcast"
            style="@style/TextStyle.Emergency.Label"
            android:gravity="center"
            android:layout_marginBottom="@dimen/spacing_3xl" />

        <!-- ===== STATUS SECTION ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/emergency_status_heading"
            style="@style/TextStyle.Emergency.Heading"
            android:layout_marginBottom="@dimen/spacing_lg" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="3"
            android:columnOrderPreserved="false">

            <!-- I'm Safe -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatusSafe"
                style="@style/Card.Dark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_column="0"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/spacing_xs"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_play_circle"
                        app:tint="@color/status_success"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/emergency_safe_status"
                        style="@style/TextStyle.Emergency.Body"
                        android:layout_marginStart="@dimen/spacing_sm" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Injured -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatusInjured"
                style="@style/Card.Dark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_column="1"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/spacing_xs"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_alert_circle"
                        app:tint="@color/status_danger"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/emergency_injured_status"
                        style="@style/TextStyle.Emergency.Body"
                        android:layout_marginStart="@dimen/spacing_sm" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Trapped -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatusTrapped"
                style="@style/Card.Dark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="1"
                android:layout_column="0"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/spacing_xs"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_alert_circle"
                        app:tint="@color/status_warning"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/emergency_trapped_status"
                        style="@style/TextStyle.Emergency.Body"
                        android:layout_marginStart="@dimen/spacing_sm" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Need Water -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatusWater"
                style="@style/Card.Dark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="1"
                android:layout_column="1"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/spacing_xs"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_weather_sunny"
                        app:tint="@color/status_info"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/emergency_need_water"
                        style="@style/TextStyle.Emergency.Body"
                        android:layout_marginStart="@dimen/spacing_sm" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Need Food -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatusFood"
                style="@style/Card.Dark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="2"
                android:layout_column="0"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/spacing_xs"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_play_circle"
                        app:tint="@color/status_warning"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/emergency_need_food"
                        style="@style/TextStyle.Emergency.Body"
                        android:layout_marginStart="@dimen/spacing_sm" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Need Medical -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatusMedical"
                style="@style/Card.Dark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="2"
                android:layout_column="1"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/spacing_xs"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_sos"
                        app:tint="@color/status_danger"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/emergency_need_medical"
                        style="@style/TextStyle.Emergency.Body"
                        android:layout_marginStart="@dimen/spacing_sm" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>

        <!-- ===== QUICK ACTIONS SECTION ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/emergency_quick_actions"
            style="@style/TextStyle.Emergency.Heading"
            android:layout_marginTop="@dimen/spacing_3xl"
            android:layout_marginBottom="@dimen/spacing_lg" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:columnOrderPreserved="false">

            <!-- Flashlight Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/emergencyFlashlightCard"
                style="@style/Card.Dark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_column="0"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/spacing_xs"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">
                    <ImageView
                        android:layout_width="@dimen/icon_lg"
                        android:layout_height="@dimen/icon_lg"
                        android:src="@drawable/ic_flashlight"
                        app:tint="@color/text_inverse"
                        android:contentDescription="@string/emergency_flashlight" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/emergency_flashlight"
                        style="@style/TextStyle.Emergency.Body"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/spacing_md" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SOS Morse"
                        style="@style/TextStyle.Emergency.Label"
                        android:layout_marginTop="@dimen/spacing_xxs" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Shelters Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/emergencySheltersCard"
                style="@style/Card.Dark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_column="1"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/spacing_xs"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">
                    <ImageView
                        android:layout_width="@dimen/icon_lg"
                        android:layout_height="@dimen/icon_lg"
                        android:src="@drawable/ic_shelter"
                        app:tint="@color/text_inverse"
                        android:contentDescription="@string/emergency_shelters" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/emergency_shelters"
                        style="@style/TextStyle.Emergency.Body"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/spacing_md" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Find nearby"
                        style="@style/TextStyle.Emergency.Label"
                        android:layout_marginTop="@dimen/spacing_xxs" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Contacts Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/emergencyContactsCard"
                style="@style/Card.Dark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="1"
                android:layout_column="0"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/spacing_xs"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">
                    <ImageView
                        android:layout_width="@dimen/icon_lg"
                        android:layout_height="@dimen/icon_lg"
                        android:src="@drawable/ic_contacts"
                        app:tint="@color/text_inverse"
                        android:contentDescription="@string/emergency_contacts" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/emergency_contacts"
                        style="@style/TextStyle.Emergency.Body"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/spacing_md" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Emergency"
                        style="@style/TextStyle.Emergency.Label"
                        android:layout_marginTop="@dimen/spacing_xxs" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Checklist Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/emergencyChecklistCard"
                style="@style/Card.Dark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="1"
                android:layout_column="1"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/spacing_xs"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">
                    <ImageView
                        android:layout_width="@dimen/icon_lg"
                        android:layout_height="@dimen/icon_lg"
                        android:src="@drawable/ic_checklist"
                        app:tint="@color/text_inverse"
                        android:contentDescription="@string/emergency_checklist" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/emergency_checklist"
                        style="@style/TextStyle.Emergency.Body"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/spacing_md" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Survival"
                        style="@style/TextStyle.Emergency.Label"
                        android:layout_marginTop="@dimen/spacing_xxs" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>

        <!-- ===== NEARBY DEVICES SECTION ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/spacing_3xl"
            android:layout_marginBottom="@dimen/spacing_lg">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/emergency_nearby_devices_heading"
                style="@style/TextStyle.Emergency.Heading" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManualDiscover"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/emergency_manual_discover"
                android:textSize="11sp"
                android:textColor="@color/text_inverse"
                app:strokeColor="@color/border_emergency"
                app:strokeWidth="1dp"
                android:layout_marginEnd="@dimen/spacing_md"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:cornerRadius="@dimen/corner_full" />

            <TextView
                android:id="@+id/meshConnectedCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 connected"
                style="@style/TextStyle.Emergency.Label"
                android:textColor="@color/status_success" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNearbyDevices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="@dimen/spacing_lg" />

        <!-- ===== MESH MESSAGES SECTION ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/emergency_mesh_messages_heading"
            style="@style/TextStyle.Emergency.Heading"
            android:layout_marginBottom="@dimen/spacing_lg" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEmergencyMessages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="@dimen/spacing_3xl" />

        <!-- ===== EXIT BUTTON ===== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExitEmergency"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="@dimen/spacing_2xl"
            android:text="@string/emergency_exit_mode"
            android:textColor="@color/text_inverse"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            app:backgroundTint="#2A2A3A"
            app:cornerRadius="@dimen/corner_full"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
