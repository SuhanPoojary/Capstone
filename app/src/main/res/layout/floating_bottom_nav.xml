<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/mainFragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/floatingNavCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_lg"
        android:layout_marginEnd="@dimen/spacing_lg"
        android:layout_marginBottom="@dimen/spacing_lg"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="@dimen/corner_2xl"
        app:cardElevation="@dimen/elevation_high"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/floatingNavContainer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/floating_nav_height"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_sm"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingBottom="@dimen/spacing_sm">

            <FrameLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:paddingHorizontal="@dimen/spacing_xs">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingStart="@dimen/spacing_sm"
                    android:paddingEnd="@dimen/spacing_sm"
                    android:paddingTop="@dimen/spacing_xs"
                    android:paddingBottom="@dimen/spacing_xs">

                    <ImageView
                        android:id="@+id/navHomeIcon"
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:contentDescription="@string/nav_home"
                        android:src="@drawable/ic_nav_home"
                        android:tint="@color/text_secondary" />

                    <TextView
                        android:id="@+id/navHomeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/nav_home"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_label_sm"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/navLab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:paddingHorizontal="@dimen/spacing_xs">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingStart="@dimen/spacing_sm"
                    android:paddingEnd="@dimen/spacing_sm"
                    android:paddingTop="@dimen/spacing_xs"
                    android:paddingBottom="@dimen/spacing_xs">

                    <ImageView
                        android:id="@+id/navLabIcon"
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:contentDescription="@string/nav_lab"
                        android:src="@drawable/ic_nav_lab"
                        android:tint="@color/text_secondary" />

                    <TextView
                        android:id="@+id/navLabLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/nav_lab"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_label_sm"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <View
                android:id="@+id/emergencyButtonContainer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/navMedReady"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:paddingHorizontal="@dimen/spacing_xs">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingStart="@dimen/spacing_sm"
                    android:paddingEnd="@dimen/spacing_sm"
                    android:paddingTop="@dimen/spacing_xs"
                    android:paddingBottom="@dimen/spacing_xs">

                    <ImageView
                        android:id="@+id/navMedReadyIcon"
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:contentDescription="@string/nav_medready"
                        android:src="@drawable/ic_nav_medready"
                        android:tint="@color/text_secondary" />

                    <TextView
                        android:id="@+id/navMedReadyLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/nav_medready"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_label_sm"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/navProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:paddingHorizontal="@dimen/spacing_xs">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingStart="@dimen/spacing_sm"
                    android:paddingEnd="@dimen/spacing_sm"
                    android:paddingTop="@dimen/spacing_xs"
                    android:paddingBottom="@dimen/spacing_xs">

                    <ImageView
                        android:id="@+id/navProfileIcon"
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:contentDescription="@string/nav_profile"
                        android:src="@drawable/ic_nav_profile"
                        android:tint="@color/text_secondary" />

                    <TextView
                        android:id="@+id/navProfileLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/nav_profile"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_label_sm"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:id="@+id/sosEmergencyButton"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="@string/sos_button"
        android:clickable="true"
        android:focusable="true"
        android:elevation="12dp"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:translationY="@dimen/floating_nav_overlap"
        app:layout_constraintBottom_toTopOf="@id/floatingNavCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/emergency_fab_glow" />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_emergency_fab"
            android:contentDescription="@string/sos_button" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

