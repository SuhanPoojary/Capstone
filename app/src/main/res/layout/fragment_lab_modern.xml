<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="@dimen/screen_padding_horizontal"
    android:paddingTop="@dimen/screen_padding_vertical"
    android:paddingEnd="@dimen/screen_padding_horizontal"
    android:paddingBottom="@dimen/fragment_bottom_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Survival Stats Hero -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_xl"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="@dimen/elevation_high"
            app:cardCornerRadius="@dimen/lab_corner_xxl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_lab_hero_gradient"
                android:orientation="vertical"
                android:padding="@dimen/spacing_2xl">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Survival Progress"
                    android:textSize="@dimen/text_body_sm"
                    android:textColor="@color/white"
                    android:alpha="0.8"
                    android:textAllCaps="true"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/labSurvivalLevel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Level 12"
                            android:textSize="@dimen/text_display_md"
                            android:textColor="@color/white"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Advanced Survivor"
                            android:textSize="@dimen/text_body_sm"
                            android:textColor="@color/white"
                            android:alpha="0.7"
                            android:fontFamily="@font/plus_jakarta_sans" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/ic_quick_game"
                        app:tint="@color/white"
                        android:alpha="0.8" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/white"
                    android:alpha="0.2"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:layout_marginBottom="@dimen/spacing_xl" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/labQuizzesDone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="24"
                            android:textSize="@dimen/text_heading_md"
                            android:textColor="@color/white"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quizzes"
                            android:textSize="@dimen/text_label_md"
                            android:textColor="@color/white"
                            android:alpha="0.6"
                            android:fontFamily="@font/plus_jakarta_sans" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/labSimulationsDone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="8"
                            android:textSize="@dimen/text_heading_md"
                            android:textColor="@color/white"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Simulations"
                            android:textSize="@dimen/text_label_md"
                            android:textColor="@color/white"
                            android:alpha="0.6"
                            android:fontFamily="@font/plus_jakarta_sans" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/labSurvivalScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="850"
                            android:textSize="@dimen/text_heading_md"
                            android:textColor="@color/white"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="XP Points"
                            android:textSize="@dimen/text_label_md"
                            android:textColor="@color/white"
                            android:alpha="0.6"
                            android:fontFamily="@font/plus_jakarta_sans" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Daily Challenge Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dailyChallengeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_2xl"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="@dimen/lab_corner_xxl"
            app:cardElevation="@dimen/elevation_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_lab_daily_gradient"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xl">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_lab_challenge_pill"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md"
                    android:paddingTop="@dimen/spacing_xxs"
                    android:paddingBottom="@dimen/spacing_xxs"
                    android:text="⚡ DAILY CHALLENGE"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_label_sm"
                    android:textStyle="bold"
                    android:fontFamily="@font/plus_jakarta_sans" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:text="First Aid: Burn Treatment"
                    android:textSize="@dimen/text_heading_md"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:fontFamily="@font/plus_jakarta_sans" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="Quick decision challenge: Identify the correct action for a 2nd-degree burn."
                    android:textSize="@dimen/text_body_sm"
                    android:textColor="@color/white"
                    android:alpha="0.9"
                    android:fontFamily="@font/plus_jakarta_sans" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="+50 XP • Ends in 4h 20m"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_label_md"
                        android:fontFamily="@font/plus_jakarta_sans" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_lab_button_primary"
                        android:paddingStart="@dimen/spacing_xl"
                        android:paddingEnd="@dimen/spacing_xl"
                        android:paddingTop="@dimen/spacing_sm"
                        android:paddingBottom="@dimen/spacing_sm"
                        android:text="Solve Now"
                        android:textColor="@color/sr_danger_red"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_body_sm"
                        android:fontFamily="@font/plus_jakarta_sans" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/simulationsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:text="Survival Simulations"
            android:textSize="@dimen/text_heading_md"
            android:textStyle="bold"
            android:textColor="@color/sr_text_primary"
            android:fontFamily="@font/plus_jakarta_sans" />

        <!-- Situational Game Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/situationalGameCard"
            style="@style/Card.Lab.Premium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_2xl"
            app:cardBackgroundColor="@android:color/transparent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_lab_simulation_blue"
                android:orientation="vertical"
                android:padding="@dimen/spacing_2xl">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_lab_icon_shell_blue">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/lab_game_title"
                        android:src="@drawable/ic_quick_game" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/lab_game_title"
                    android:textSize="@dimen/text_heading_md"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:fontFamily="@font/plus_jakarta_sans" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/lab_game_body"
                    android:textSize="@dimen/text_body_sm"
                    android:textColor="@color/color_gray_200"
                    android:fontFamily="@font/plus_jakarta_sans" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:text="@string/lab_game_action"
                    android:background="@drawable/bg_lab_button_gradient"
                    android:textColor="@color/white"
                    android:paddingStart="@dimen/spacing_lg"
                    android:paddingTop="@dimen/spacing_sm"
                    android:paddingEnd="@dimen/spacing_lg"
                    android:paddingBottom="@dimen/spacing_sm"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_body_sm"
                    android:fontFamily="@font/plus_jakarta_sans" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Role-Based Game Placeholder -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/roleBasedGameCard"
            style="@style/Card.Lab.Premium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_2xl"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@android:color/transparent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_lab_simulation_orange"
                android:orientation="vertical"
                android:padding="@dimen/spacing_2xl">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_lab_icon_shell_orange">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="Role-Based Game"
                        android:src="@drawable/ic_quick_game" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="Role-Based Game"
                    android:textSize="@dimen/text_heading_md"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:fontFamily="@font/plus_jakarta_sans" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="Play as different roles in disaster scenarios"
                    android:textSize="@dimen/text_body_sm"
                    android:textColor="@color/color_gray_200"
                    android:fontFamily="@font/plus_jakarta_sans" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:text="Coming Soon"
                    android:background="@drawable/bg_lab_button_gradient"
                    android:textColor="@color/white"
                    android:paddingStart="@dimen/spacing_lg"
                    android:paddingTop="@dimen/spacing_sm"
                    android:paddingEnd="@dimen/spacing_lg"
                    android:paddingBottom="@dimen/spacing_sm"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_body_sm"
                    android:fontFamily="@font/plus_jakarta_sans" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quiz Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_md"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Disaster Preparedness Quiz"
                android:textSize="@dimen/text_heading_md"
                android:textStyle="bold"
                android:textColor="@color/sr_text_primary"
                android:fontFamily="@font/plus_jakarta_sans" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Take Quiz"
                android:textSize="@dimen/text_body_md"
                android:textColor="@color/sr_primary_navy"
                android:textStyle="bold"
                android:fontFamily="@font/plus_jakarta_sans" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/quizCard"
            style="@style/Card.Lab.Surface"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_2xl"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AI-Generated Quizzes"
                            android:textSize="@dimen/text_heading_sm"
                            android:textStyle="bold"
                            android:textColor="@color/sr_text_primary"
                            android:fontFamily="@font/plus_jakarta_sans" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:text="5 questions • Timed • Get explanations"
                            android:textSize="@dimen/text_body_sm"
                            android:textColor="@color/sr_text_secondary"
                            android:fontFamily="@font/plus_jakarta_sans" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_lab_icon_shell_blue">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_quick_quiz" />
                    </FrameLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/startQuizButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height_large"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="Start Quiz Levels"
                    android:textAllCaps="false"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/corner_lg"
                    android:backgroundTint="@color/sr_primary_navy" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Video Learning Section -->
        <TextView
            android:id="@+id/videoLearningTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            android:text="Training Modules"
            android:textSize="@dimen/text_heading_md"
            android:textStyle="bold"
            android:textColor="@color/sr_text_primary"
            android:fontFamily="@font/plus_jakarta_sans" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_2xl"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Earthquake Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardEarthquake"
                    style="@style/Card.Lab.Premium"
                    android:layout_width="@dimen/lab_simulation_card_width"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_lg"
                    app:cardBackgroundColor="@android:color/transparent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_lab_simulation_teal"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_lg">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_lab_icon_shell_teal">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_art_earthquake" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:text="Earthquake"
                            android:textSize="@dimen/text_heading_sm"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:fontFamily="@font/plus_jakarta_sans" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:text="Learn Drop, Cover, and Hold on techniques."
                            android:textSize="@dimen/text_body_sm"
                            android:textColor="@color/color_gray_200"
                            android:fontFamily="@font/plus_jakarta_sans" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:text="Start Training"
                            android:background="@drawable/bg_lab_button_gradient"
                            android:textColor="@color/white"
                            android:paddingStart="@dimen/spacing_lg"
                            android:paddingTop="@dimen/spacing_sm"
                            android:paddingEnd="@dimen/spacing_lg"
                            android:paddingBottom="@dimen/spacing_sm"
                            android:textStyle="bold"
                            android:textSize="@dimen/text_body_sm"
                            android:fontFamily="@font/plus_jakarta_sans" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Floods Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFloods"
                    style="@style/Card.Lab.Premium"
                    android:layout_width="@dimen/lab_simulation_card_width"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_lg"
                    app:cardBackgroundColor="@android:color/transparent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_lab_simulation_blue"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_lg">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_lab_icon_shell_blue">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_art_floods" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:text="Floods"
                            android:textSize="@dimen/text_heading_sm"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:fontFamily="@font/plus_jakarta_sans" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:text="Emergency kits and evacuation routes."
                            android:textSize="@dimen/text_body_sm"
                            android:textColor="@color/color_gray_200"
                            android:fontFamily="@font/plus_jakarta_sans" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:text="Start Training"
                            android:background="@drawable/bg_lab_button_gradient"
                            android:textColor="@color/white"
                            android:paddingStart="@dimen/spacing_lg"
                            android:paddingTop="@dimen/spacing_sm"
                            android:paddingEnd="@dimen/spacing_lg"
                            android:paddingBottom="@dimen/spacing_sm"
                            android:textStyle="bold"
                            android:textSize="@dimen/text_body_sm"
                            android:fontFamily="@font/plus_jakarta_sans" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Cyclone Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCyclone"
                    style="@style/Card.Lab.Premium"
                    android:layout_width="@dimen/lab_simulation_card_width"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_lg"
                    app:cardBackgroundColor="@android:color/transparent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_lab_simulation_purple"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_lg">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_lab_icon_shell_purple">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_art_cyclone" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:text="Cyclone"
                            android:textSize="@dimen/text_heading_sm"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:fontFamily="@font/plus_jakarta_sans" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:text="Structural safety and weather tracking."
                            android:textSize="@dimen/text_body_sm"
                            android:textColor="@color/color_gray_200"
                            android:fontFamily="@font/plus_jakarta_sans" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:text="Start Training"
                            android:background="@drawable/bg_lab_button_gradient"
                            android:textColor="@color/white"
                            android:paddingStart="@dimen/spacing_lg"
                            android:paddingTop="@dimen/spacing_sm"
                            android:paddingEnd="@dimen/spacing_lg"
                            android:paddingBottom="@dimen/spacing_sm"
                            android:textStyle="bold"
                            android:textSize="@dimen/text_body_sm"
                            android:fontFamily="@font/plus_jakarta_sans" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Landslides Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLandslides"
                    style="@style/Card.Lab.Premium"
                    android:layout_width="@dimen/lab_simulation_card_width"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_lg"
                    app:cardBackgroundColor="@android:color/transparent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_lab_simulation_red"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_lg">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_lab_icon_shell_red">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_art_landslides" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:text="Landslides"
                            android:textSize="@dimen/text_heading_sm"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:fontFamily="@font/plus_jakarta_sans" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:text="Early warning signs and safe zones."
                            android:textSize="@dimen/text_body_sm"
                            android:textColor="@color/color_gray_200"
                            android:fontFamily="@font/plus_jakarta_sans" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:text="Start Training"
                            android:background="@drawable/bg_lab_button_gradient"
                            android:textColor="@color/white"
                            android:paddingStart="@dimen/spacing_lg"
                            android:paddingTop="@dimen/spacing_sm"
                            android:paddingEnd="@dimen/spacing_lg"
                            android:paddingBottom="@dimen/spacing_sm"
                            android:textStyle="bold"
                            android:textSize="@dimen/text_body_sm"
                            android:fontFamily="@font/plus_jakarta_sans" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </HorizontalScrollView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/video_card_disasters"
            style="@style/Card.Lab.Surface"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Disaster Modules"
                            android:textSize="@dimen/text_heading_sm"
                            android:textStyle="bold"
                            android:textColor="@color/sr_text_primary"
                            android:fontFamily="@font/plus_jakarta_sans" />

                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_lab_icon_shell_blue">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_quick_books" />
                    </FrameLayout>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/videoLearningProgress"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/progress_bar_height"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/bg_lab_progress_learning" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
