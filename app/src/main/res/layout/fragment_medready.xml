<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sr_bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/medreadyMainLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/screen_padding_vertical"
        android:paddingBottom="@dimen/fragment_bottom_padding">

        <!-- ============ HEADER ============ -->
        <TextView
            android:id="@+id/medreadyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/medready_title"
            android:textSize="@dimen/text_heading_lg"
            android:textStyle="bold"
            android:textColor="@color/sr_text_primary"
            android:fontFamily="@font/plus_jakarta_sans"
            android:layout_marginBottom="@dimen/spacing_xs" />

        <ProgressBar
            android:id="@+id/medreadyProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:indeterminate="true"
            android:layout_marginBottom="@dimen/spacing_md" />

        <TextView
            android:id="@+id/medreadySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/medready_subtitle"
            android:textSize="@dimen/text_body_md"
            android:textColor="@color/sr_text_secondary"
            android:fontFamily="@font/plus_jakarta_sans"
            android:layout_marginBottom="@dimen/spacing_2xl" />

        <!-- ============ HERO CARD ============ -->
        <androidx.cardview.widget.CardView
            android:id="@+id/heroCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/sr_accent_navy"
            app:cardCornerRadius="@dimen/medready_hero_corner"
            app:cardElevation="@dimen/elevation_light">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/medready_hero_padding"
                android:gravity="center_horizontal">

                <!-- Scan Icon Container -->
                <FrameLayout
                    android:layout_width="@dimen/medready_icon_container_size"
                    android:layout_height="@dimen/medready_icon_container_size"
                    android:layout_marginBottom="@dimen/spacing_2xl"
                    android:background="@drawable/bg_medready_button_primary"
                    android:alpha="0.15">

                    <ImageView
                        android:layout_width="@dimen/medready_icon_container_size"
                        android:layout_height="@dimen/medready_icon_container_size"
                        android:src="@drawable/ic_medready_scan_qr"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/medready_hero_title" />

                </FrameLayout>

                <!-- Hero Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/medready_hero_title"
                    android:textSize="@dimen/text_heading_lg"
                    android:textStyle="bold"
                    android:textColor="@color/bg_card"
                    android:textAlignment="center"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <!-- Hero Description -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/medready_hero_desc"
                    android:textSize="@dimen/text_body_md"
                    android:textColor="@color/bg_card"
                    android:textAlignment="center"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:alpha="0.9"
                    android:layout_marginBottom="@dimen/spacing_2xl"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md" />

                <!-- Button Container -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <!-- Take Photo Button -->
                    <Button
                        android:id="@+id/medreadyTakePhotoButton"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/medready_button_height"
                        android:paddingStart="@dimen/spacing_2xl"
                        android:paddingEnd="@dimen/spacing_2xl"
                        android:text="@string/medready_btn_take_photo"
                        android:textSize="@dimen/text_body_md"
                        android:textStyle="bold"
                        android:textColor="@color/sr_text_primary"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:background="@drawable/bg_medready_button_primary"
                        android:layout_marginEnd="@dimen/spacing_lg" />

                    <!-- Upload Button -->
                    <Button
                        android:id="@+id/medreadyUploadButton"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/medready_button_height"
                        android:paddingStart="@dimen/spacing_2xl"
                        android:paddingEnd="@dimen/spacing_2xl"
                        android:text="@string/medready_btn_upload"
                        android:textSize="@dimen/text_body_md"
                        android:textStyle="bold"
                        android:textColor="@color/sr_text_primary"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:background="@drawable/bg_medready_button_primary"
                        android:alpha="0.8" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ============ SPACING ============ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_3xl"
            android:layout_marginTop="@dimen/spacing_lg" />

        <!-- ============ WHAT WE ANALYZE SECTION ============ -->
        <TextView
            android:id="@+id/whatAnalyzeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/medready_what_analyze"
            android:textSize="@dimen/text_heading_md"
            android:textStyle="bold"
            android:textColor="@color/sr_text_primary"
            android:fontFamily="@font/plus_jakarta_sans"
            android:layout_marginBottom="@dimen/spacing_lg" />

        <!-- Grid Container -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:layout_marginBottom="@dimen/spacing_3xl">

            <!-- Card 1: Medicine Detection -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="@dimen/medready_card_corner"
                app:cardElevation="@dimen/elevation_light"
                android:layout_row="0"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:layout_marginEnd="@dimen/medready_grid_spacing"
                android:layout_marginBottom="@dimen/medready_grid_spacing">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_lg"
                        android:layout_height="@dimen/icon_lg"
                        android:src="@drawable/ic_medready_detection"
                        android:contentDescription="@string/medready_detection"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:tint="@color/sr_primary_navy" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/medready_detection"
                        android:textSize="@dimen/text_body_lg"
                        android:textStyle="bold"
                        android:textColor="@color/sr_text_primary"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:textAlignment="center"
                        android:layout_marginBottom="@dimen/spacing_xs" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/medready_detection_desc"
                        android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/sr_text_secondary"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:textAlignment="center" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Card 2: Expiry Tracking -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="@dimen/medready_card_corner"
                app:cardElevation="@dimen/elevation_light"
                android:layout_row="0"
                android:layout_column="1"
                android:layout_columnWeight="1"
                android:layout_marginBottom="@dimen/medready_grid_spacing">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_lg"
                        android:layout_height="@dimen/icon_lg"
                        android:src="@drawable/ic_medready_expiry"
                        android:contentDescription="@string/medready_expiry_tracking"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:tint="@color/sr_primary_navy" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/medready_expiry_tracking"
                        android:textSize="@dimen/text_body_lg"
                        android:textStyle="bold"
                        android:textColor="@color/sr_text_primary"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:textAlignment="center"
                        android:layout_marginBottom="@dimen/spacing_xs" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/medready_expiry_tracking_desc"
                        android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/sr_text_secondary"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:textAlignment="center" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Card 3: Missing Items -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="@dimen/medready_card_corner"
                app:cardElevation="@dimen/elevation_light"
                android:layout_row="1"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:layout_marginEnd="@dimen/medready_grid_spacing">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_lg"
                        android:layout_height="@dimen/icon_lg"
                        android:src="@drawable/ic_medready_missing"
                        android:contentDescription="@string/medready_missing_items"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:tint="@color/sr_primary_navy" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/medready_missing_items"
                        android:textSize="@dimen/text_body_lg"
                        android:textStyle="bold"
                        android:textColor="@color/sr_text_primary"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:textAlignment="center"
                        android:layout_marginBottom="@dimen/spacing_xs" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/medready_missing_items_desc"
                        android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/sr_text_secondary"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:textAlignment="center" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Card 4: Readiness Score -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="@dimen/medready_card_corner"
                app:cardElevation="@dimen/elevation_light"
                android:layout_row="1"
                android:layout_column="1"
                android:layout_columnWeight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_lg"
                        android:layout_height="@dimen/icon_lg"
                        android:src="@drawable/ic_medready_readiness"
                        android:contentDescription="@string/medready_readiness_score"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:tint="@color/sr_primary_navy" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/medready_readiness_score"
                        android:textSize="@dimen/text_body_lg"
                        android:textStyle="bold"
                        android:textColor="@color/sr_text_primary"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:textAlignment="center"
                        android:layout_marginBottom="@dimen/spacing_xs" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/medready_readiness_score_desc"
                        android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/sr_text_secondary"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:textAlignment="center" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </GridLayout>

        <!-- ============ PREVIOUS SCANS SECTION ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_lg">

            <TextView
                android:id="@+id/previousScansTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/medready_previous_scans"
                android:textSize="@dimen/text_heading_md"
                android:textStyle="bold"
                android:textColor="@color/sr_text_primary"
                android:fontFamily="@font/plus_jakarta_sans" />

            <TextView
                android:id="@+id/viewAllButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/medready_view_all"
                android:textSize="@dimen/text_body_md"
                android:textStyle="bold"
                android:textColor="@color/sr_primary_navy"
                android:fontFamily="@font/plus_jakarta_sans"
                android:paddingStart="@dimen/spacing_lg"
                android:paddingEnd="@dimen/spacing_lg"
                android:paddingTop="@dimen/spacing_xs"
                android:paddingBottom="@dimen/spacing_xs" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/medreadyHistoryContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

