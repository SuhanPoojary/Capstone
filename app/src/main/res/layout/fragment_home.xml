<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/dashboard_bg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/homeRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/homeGreeting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="Good morning 👋"
            android:textColor="@color/dashboard_greeting"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/homeUserName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif"
            android:text="User"
            android:textColor="@color/dashboard_name"
            android:textSize="28sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/homeGreeting" />

        <TextView
            android:id="@+id/homeRegion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif"
            android:text="📍 Location unavailable"
            android:textColor="@color/dashboard_greeting"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/homeUserName" />

        <TextView
            android:id="@+id/homeEmergencyBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_chip_active"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="Emergency Mode OFF"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/homeRegion" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/homeSendSosButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:text="Send SOS"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@color/dashboard_primary"
            app:cornerRadius="20dp"
            app:layout_constraintStart_toEndOf="@id/homeEmergencyBadge"
            app:layout_constraintTop_toBottomOf="@id/homeRegion" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/homeSummaryCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_white_card"
            android:elevation="2dp"
            android:padding="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/homeEmergencyBadge">

            <TextView
                android:id="@+id/homeProgressLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Preparedness Progress"
                android:textColor="@color/dashboard_name"
                android:textSize="16sp"
                app:layout_constraintEnd_toStartOf="@id/homeProgressPercent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/homeProgressPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="0%"
                android:textColor="@color/dashboard_name"
                android:textSize="18sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/homeStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_chip_active"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Ready"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/homeProgressPercent" />

            <ProgressBar
                android:id="@+id/homeProgressBar"
                style="@style/Widget.SafeReady.ProgressBar"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/dashboard_primary"
                android:progressBackgroundTint="@color/dashboard_progress_bg"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/homeStatusBadge" />

            <TextView
                android:id="@+id/homeRecommendationTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:text="Recommended next lesson"
                android:textColor="@color/dashboard_name"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/homeProgressBar" />

            <TextView
                android:id="@+id/homeRecommendationBody"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="4dp"
                android:text="Your recommended lesson will appear here."
                android:textColor="@color/dashboard_greeting"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/homeRecommendationTitle" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/homeStartTrainingButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-medium"
            android:text="Start Training"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@color/safeready_navy"
            app:cornerRadius="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/homeSummaryCard" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/homeViewProgressButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="View Progress"
            android:textAllCaps="false"
            android:textColor="@color/safeready_navy"
            app:backgroundTint="@color/white"
            app:cornerRadius="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/homeStartTrainingButton"
            app:strokeColor="@color/safeready_navy"
            app:strokeWidth="2dp" />

        <TextView
            android:id="@+id/homeGamificationText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif"
            android:text="Level 1 • 0-day streak • 0 points"
            android:textColor="@color/dashboard_greeting"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/homeViewProgressButton" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

