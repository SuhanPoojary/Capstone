<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <!-- Loading State -->
    <LinearLayout
        android:id="@+id/quizLoadingContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:background="@color/bg_app">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/TextStyle.Body.Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="Loading quiz..."
            android:textColor="@color/color_navy_900" />
    </LinearLayout>

    <!-- Empty / Error State -->
    <LinearLayout
        android:id="@+id/quizEmptyContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_app"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/quizEmptyMessage"
            style="@style/TextStyle.Body.Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quiz could not be loaded."
            android:textColor="@color/color_navy_900" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/quizFallbackRetryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="Try Again"
            android:textAllCaps="false" />
    </LinearLayout>

    <!-- Quiz State -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/quizContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_cream_50"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_lg">

                <ImageButton
                    android:id="@+id/quizBackButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="Back"
                    android:src="@drawable/ic_arrow_back" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/spacing_md">

                    <TextView
                        style="@style/TextStyle.Heading.Medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Disaster Preparedness Quiz"
                        android:textColor="@color/color_navy_900" />

                    <TextView
                        android:id="@+id/quizProgressText"
                        style="@style/TextStyle.Body.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="1/5"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/quizProgressBar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/progress_bar_height"
                android:layout_marginBottom="@dimen/spacing_2xl"
                android:max="5"
                android:progress="1"
                android:progressDrawable="@drawable/bg_lab_progress_learning" />

            <!-- Question Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="@dimen/corner_xl"
                app:cardElevation="2dp"
                app:strokeColor="@color/border_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_xl">

                    <TextView
                        android:id="@+id/quizQuestionText"
                        style="@style/TextStyle.Heading.Small"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Question text here"
                        android:textColor="@color/color_navy_900"
                        android:lineSpacingMultiplier="1.2" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Options Container -->
            <LinearLayout
                android:id="@+id/quizOptionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/spacing_2xl" />

            <!-- Next Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/quizNextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Next"
                android:enabled="false"
                android:textAllCaps="false" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Explanation State -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/quizExplanationContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_2xl"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="@dimen/corner_2xl"
                app:cardElevation="@dimen/elevation_light">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        android:id="@+id/quizExplanationText"
                        style="@style/TextStyle.Body.Medium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Explanation here"
                        android:textColor="@color/color_navy_900"
                        android:lineSpacingMultiplier="1.5" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quizContinueButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Next Question"
                android:textAllCaps="false" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Results State -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/quizResultContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_2xl"
            android:gravity="center">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_2xl"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="@dimen/corner_2xl"
                app:cardElevation="@dimen/elevation_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_2xl"
                    android:gravity="center">

                    <TextView
                        style="@style/TextStyle.Body.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your Score"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/quizFinalScore"
                        style="@style/TextStyle.Display.Large"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:text="80%"
                        android:textColor="@color/status_success" />

                    <TextView
                        android:id="@+id/quizSummaryText"
                        style="@style/TextStyle.Body.Medium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_2xl"
                        android:gravity="center"
                        android:text="Summary here"
                        android:textColor="@color/color_navy_900"
                        android:lineSpacingMultiplier="1.5" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quizNextLevelButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Go to Next Level"
                android:visibility="gone"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quizRetryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Try Again"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quizExitButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="Exit Quiz"
                android:textAllCaps="false" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
