<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_emergency"
    android:paddingStart="@dimen/spacing_lg"
    android:paddingEnd="@dimen/spacing_lg"
    android:paddingTop="@dimen/spacing_2xl"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== HEADER SECTION ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_2xl">

            <TextView
                android:id="@+id/emergencyTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/emergency_mode_title"
                android:textColor="@color/text_inverse"
                android:textSize="@dimen/text_display_md"
                android:textStyle="bold" />

            <!-- ACTIVE Pill -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/corner_lg"
                app:cardBackgroundColor="@color/color_red_600"
                app:cardElevation="0dp">
                <TextView
                    android:id="@+id/emergencyActivePill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md"
                    android:paddingTop="@dimen/spacing_xs"
                    android:paddingBottom="@dimen/spacing_xs"
                    android:text="@string/emergency_active"
                    android:textColor="@color/text_inverse"
                    android:textSize="@dimen/text_label_md"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ===== DEVICE STATUS ROW ===== -->
        <LinearLayout
            android:id="@+id/deviceStatusRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="4"
            android:layout_marginBottom="@dimen/spacing_3xl">

            <!-- Battery -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:src="@drawable/ic_battery"
                    android:tint="@color/text_inverse"
                    android:contentDescription="@string/emergency_battery_status" />
                <TextView
                    android:id="@+id/batteryStatusValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="78%"
                    android:textColor="@color/text_inverse"
                    android:textSize="@dimen/text_body_md"
                    android:textStyle="bold"
                    android:layout_marginTop="@dimen/spacing_xs" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Battery"
                    android:textColor="@color/text_inverse"
                    android:textSize="@dimen/text_body_sm"
                    android:layout_marginTop="@dimen/spacing_xs" />
            </LinearLayout>

            <!-- Network -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:src="@drawable/ic_weather_sunny"
                    android:tint="@color/text_inverse"
                    android:contentDescription="Network" />
                <TextView
                    android:id="@+id/networkStatusValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4G"
                    android:textColor="@color/text_inverse"
                    android:textSize="@dimen/text_body_md"
                    android:textStyle="bold"
                    android:layout_marginTop="@dimen/spacing_xs" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Network"
                    android:textColor="@color/text_inverse"
                    android:textSize="@dimen/text_body_sm"
                    android:layout_marginTop="@dimen/spacing_xs" />
            </LinearLayout>

            <!-- Mesh -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:src="@drawable/ic_alert_circle"
                    android:tint="@color/text_inverse"
                    android:contentDescription="Mesh Network" />
                <TextView
                    android:id="@+id/meshStatusValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/text_inverse"
                    android:textSize="@dimen/text_body_md"
                    android:textStyle="bold"
                    android:layout_marginTop="@dimen/spacing_xs" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mesh"
                    android:textColor="@color/text_inverse"
                    android:textSize="@dimen/text_body_sm"
                    android:layout_marginTop="@dimen/spacing_xs" />
            </LinearLayout>

            <!-- GPS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:src="@drawable/ic_location"
                    android:tint="@color/text_inverse"
                    android:contentDescription="GPS" />
                <TextView
                    android:id="@+id/gpsStatusValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Off"
                    android:textColor="@color/text_inverse"
                    android:textSize="@dimen/text_body_md"
                    android:textStyle="bold"
                    android:layout_marginTop="@dimen/spacing_xs" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPS"
                    android:textColor="@color/text_inverse"
                    android:textSize="@dimen/text_body_sm"
                    android:layout_marginTop="@dimen/spacing_xs" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== SOS BUTTON ===== -->
        <FrameLayout
            android:id="@+id/btnSendSosEmergency"
            android:layout_width="@dimen/emergency_button_size_large"
            android:layout_height="@dimen/emergency_button_size_large"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:background="@drawable/emergency_fab_background"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/emergency_sos_broadcast">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_gravity="center">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/icon_xl"
                    android:layout_height="@dimen/icon_xl"
                    android:src="@drawable/ic_sos"
                    android:tint="@color/white"
                    android:contentDescription="@string/emergency_sos_broadcast" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/emergency_sos_short"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_body_md"
                    android:textStyle="bold"
                    android:layout_marginTop="@dimen/spacing_sm" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/emergency_broadcasting"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_body_sm"
                    android:layout_marginTop="@dimen/spacing_xs" />
            </LinearLayout>
        </FrameLayout>

        <!-- Location broadcast message -->
        <TextView
            android:id="@+id/emergencyLastAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/emergency_location_broadcast"
            android:textColor="@color/text_inverse"
            android:textSize="@dimen/text_body_sm"
            android:gravity="center"
            android:layout_marginBottom="@dimen/spacing_3xl"
            android:alpha="0.8" />

        <!-- ===== STATUS SECTION ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/emergency_status_heading"
            android:textColor="@color/text_inverse"
            android:textSize="@dimen/text_heading_md"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/spacing_lg" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="3"
            android:columnOrderPreserved="false">

            <!-- I'm Safe (Selected) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatusSafe"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_column="0"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/spacing_sm"
                app:cardCornerRadius="@dimen/corner_lg"
                app:cardBackgroundColor="@color/color_green_500"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="@dimen/spacing_lg">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓"
                        android:textColor="@color/text_inverse"
                        android:textSize="@dimen/text_heading_lg"
                        android:layout_marginBottom="@dimen/spacing_sm" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="I'm Safe"
                        android:textColor="@color/text_inverse"
                        android:textSize="@dimen/text_body_md"
                        android:textStyle="bold"
                        android:gravity="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Injured (Unselected) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatusInjured"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_column="1"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/spacing_sm"
                app:cardCornerRadius="@dimen/corner_lg"
                app:cardBackgroundColor="@color/color_navy_600"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="@dimen/spacing_lg">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠"
                        android:textColor="@color/text_inverse"
                        android:textSize="@dimen/text_heading_lg"
                        android:layout_marginBottom="@dimen/spacing_sm" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Injured"
                        android:textColor="@color/text_inverse"
                        android:textSize="@dimen/text_body_md"
                        android:textStyle="bold"
                        android:gravity="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Trapped (Unselected) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatusTrapped"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="1"
                android:layout_column="0"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/spacing_sm"
                app:cardCornerRadius="@dimen/corner_lg"
                app:cardBackgroundColor="@color/color_navy_600"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="@dimen/spacing_lg">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⛔"
                        android:textColor="@color/text_inverse"
                        android:textSize="@dimen/text_heading_lg"
                        android:layout_marginBottom="@dimen/spacing_sm" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trapped"
                        android:textColor="@color/text_inverse"
                        android:textSize="@dimen/text_body_md"
                        android:textStyle="bold"
                        android:gravity="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Need Food (Unselected) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatusFood"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="1"
                android:layout_column="1"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/spacing_sm"
                app:cardCornerRadius="@dimen/corner_lg"
                app:cardBackgroundColor="@color/color_navy_600"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="@dimen/spacing_lg">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🍽"
                        android:textColor="@color/text_inverse"
                        android:textSize="@dimen/text_heading_lg"
                        android:layout_marginBottom="@dimen/spacing_sm" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Need Food"
                        android:textColor="@color/text_inverse"
                        android:textSize="@dimen/text_body_md"
                        android:textStyle="bold"
                        android:gravity="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Medical Help (Unselected) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatusMedical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="2"
                android:layout_column="0"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/spacing_sm"
                app:cardCornerRadius="@dimen/corner_lg"
                app:cardBackgroundColor="@color/color_navy_600"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="@dimen/spacing_lg">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚕"
                        android:textColor="@color/text_inverse"
                        android:textSize="@dimen/text_heading_lg"
                        android:layout_marginBottom="@dimen/spacing_sm" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Medical Help"
                        android:textColor="@color/text_inverse"
                        android:textSize="@dimen/text_body_md"
                        android:textStyle="bold"
                        android:gravity="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Need Water (Unselected) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatusWater"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="2"
                android:layout_column="1"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/spacing_sm"
                app:cardCornerRadius="@dimen/corner_lg"
                app:cardBackgroundColor="@color/color_navy_600"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="@dimen/spacing_lg">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💧"
                        android:textColor="@color/text_inverse"
                        android:textSize="@dimen/text_heading_lg"
                        android:layout_marginBottom="@dimen/spacing_sm" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Need Water"
                        android:textColor="@color/text_inverse"
                        android:textSize="@dimen/text_body_md"
                        android:textStyle="bold"
                        android:gravity="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>

        <!-- ===== QUICK ACTIONS SECTION ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/emergency_quick_actions"
            android:textColor="@color/text_inverse"
            android:textSize="@dimen/text_heading_md"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/spacing_3xl"
            android:layout_marginBottom="@dimen/spacing_lg" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:columnOrderPreserved="false">

            <!-- Flashlight Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/emergencyFlashlightCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_column="0"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/spacing_sm"
                app:cardCornerRadius="@dimen/corner_lg"
                app:cardBackgroundColor="@color/color_navy_600"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">
                    <ImageView
                        android:layout_width="@dimen/icon_lg"
                        android:layout_height="@dimen/icon_lg"
                        android:src="@drawable/ic_flashlight"
                        android:tint="@color/text_inverse"
                        android:contentDescription="Flashlight" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Flashlight"
                        android:textColor="@color/text_inverse"
                        android:textSize="@dimen/text_body_md"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/spacing_md" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SOS Morse"
                        android:textColor="@color/text_inverse"
                        android:textSize="@dimen/text_body_sm"
                        android:alpha="0.7"
                        android:layout_marginTop="@dimen/spacing_xs" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Shelters Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/emergencySheltersCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_column="1"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/spacing_sm"
                app:cardCornerRadius="@dimen/corner_lg"
                app:cardBackgroundColor="@color/color_navy_600"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">
                    <ImageView
                        android:layout_width="@dimen/icon_lg"
                        android:layout_height="@dimen/icon_lg"
                        android:src="@drawable/ic_shelter"
                        android:tint="@color/text_inverse"
                        android:contentDescription="Shelters" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shelters"
                        android:textColor="@color/text_inverse"
                        android:textSize="@dimen/text_body_md"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/spacing_md" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Find nearby"
                        android:textColor="@color/text_inverse"
                        android:textSize="@dimen/text_body_sm"
                        android:alpha="0.7"
                        android:layout_marginTop="@dimen/spacing_xs" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Contacts Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/emergencyContactsCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="1"
                android:layout_column="0"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/spacing_sm"
                app:cardCornerRadius="@dimen/corner_lg"
                app:cardBackgroundColor="@color/color_navy_600"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">
                    <ImageView
                        android:layout_width="@dimen/icon_lg"
                        android:layout_height="@dimen/icon_lg"
                        android:src="@drawable/ic_contacts"
                        android:tint="@color/text_inverse"
                        android:contentDescription="Contacts" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Contacts"
                        android:textColor="@color/text_inverse"
                        android:textSize="@dimen/text_body_md"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/spacing_md" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Emergency"
                        android:textColor="@color/text_inverse"
                        android:textSize="@dimen/text_body_sm"
                        android:alpha="0.7"
                        android:layout_marginTop="@dimen/spacing_xs" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Checklist Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/emergencyChecklistCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="1"
                android:layout_column="1"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/spacing_sm"
                app:cardCornerRadius="@dimen/corner_lg"
                app:cardBackgroundColor="@color/color_navy_600"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">
                    <ImageView
                        android:layout_width="@dimen/icon_lg"
                        android:layout_height="@dimen/icon_lg"
                        android:src="@drawable/ic_checklist"
                        android:tint="@color/text_inverse"
                        android:contentDescription="Checklist" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Checklist"
                        android:textColor="@color/text_inverse"
                        android:textSize="@dimen/text_body_md"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/spacing_md" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Survival"
                        android:textColor="@color/text_inverse"
                        android:textSize="@dimen/text_body_sm"
                        android:alpha="0.7"
                        android:layout_marginTop="@dimen/spacing_xs" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>

        <!-- ===== NEARBY DEVICES SECTION ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/spacing_3xl"
            android:layout_marginBottom="@dimen/spacing_lg">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/emergency_nearby_devices_heading"
                android:textColor="@color/text_inverse"
                android:textSize="@dimen/text_heading_md"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/meshConnectedCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢 0 connected"
                android:textColor="@color/color_green_500"
                android:textSize="@dimen/text_body_sm" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNearbyDevices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="@dimen/spacing_3xl" />

        <!-- ===== OFFLINE MAPS SECTION ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_lg"
            app:cardCornerRadius="@dimen/corner_lg"
            app:cardBackgroundColor="@color/color_navy_600"
            app:cardElevation="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_lg"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="@dimen/icon_lg"
                    android:layout_height="@dimen/icon_lg"
                    android:src="@drawable/ic_map"
                    android:tint="@color/text_inverse"
                    android:contentDescription="Maps" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/spacing_lg"
                    android:paddingEnd="@dimen/spacing_lg">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Offline Maps Active"
                        android:textColor="@color/text_inverse"
                        android:textSize="@dimen/text_body_md"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mumbai Region • 25 MB cached"
                        android:textColor="@color/text_inverse"
                        android:textSize="@dimen/text_body_sm"
                        android:alpha="0.7"
                        android:layout_marginTop="@dimen/spacing_xs" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View"
                    android:textColor="@color/color_green_500"
                    android:textSize="@dimen/text_body_sm"
                    android:textStyle="bold"
                    android:padding="@dimen/spacing_md" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== BATTERY SAVER SECTION ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_3xl"
            app:cardCornerRadius="@dimen/corner_lg"
            app:cardBackgroundColor="@color/color_navy_600"
            app:cardElevation="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Battery Saver Mode Active"
                    android:textColor="@color/text_inverse"
                    android:textSize="@dimen/text_body_md"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Non-essential features are disabled to preserve battery. SOS broadcasting will continue in background."
                    android:textColor="@color/text_inverse"
                    android:textSize="@dimen/text_body_sm"
                    android:alpha="0.7"
                    android:layout_marginTop="@dimen/spacing_md" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== EXIT BUTTON ===== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExitEmergency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_2xl"
            android:text="@string/emergency_exit_mode"
            android:textColor="@color/text_inverse"
            android:textSize="@dimen/text_body_md"
            app:cornerRadius="@dimen/corner_lg"
            app:strokeColor="@color/text_inverse"
            app:strokeWidth="2dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
