<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/txt_mesh_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mesh Debug"
        android:textAppearance="?attr/textAppearanceHeadline6" />

    <TextView
        android:id="@+id/txt_mesh_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_chip_active"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="Idle"
        android:textColor="@color/white"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/txt_mesh_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Status: idle"
        android:textAppearance="?attr/textAppearanceBody2" />

    <TextView
        android:id="@+id/txt_mesh_messages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Messages: 0"
        android:textAppearance="?attr/textAppearanceBody2" />

    <TextView
        android:id="@+id/txt_mesh_telemetry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Sent: 0 • Relayed: 0 • Failed: 0 • Retries: 0"
        android:textAppearance="?attr/textAppearanceBody2" />

    <Button
        android:id="@+id/btn_start_mesh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Mesh" />

    <Button
        android:id="@+id/btn_stop_mesh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stop Mesh"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btn_send_sos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Send Test SOS"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btn_clear_telemetry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Clear Telemetry" />

    <Button
        android:id="@+id/btn_resend_failed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Resend Latest Failed" />

</LinearLayout>

